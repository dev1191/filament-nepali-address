{
    "name": "dev1191/filament-nepali-address",
    "description": "A comprehensive Nepali address plugin for Filament (v4 & v5) providing cascading selects, searchable columns, filters, infolists, and validation.",
    "keywords": [
        "dev1191",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "nepal",
        "nepali-address",
        "provinces",
        "districts",
        "municipalities",
        "local-bodies"
    ],
    "homepage": "https://github.com/dev1191/filament-nepali-address",
    "support": {
        "issues": "https://github.com/dev1191/filament-nepali-address/issues",
        "source": "https://github.com/dev1191/filament-nepali-address"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Dev Raj Thapa",
            "email": "devrajthapa1191@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "khanaldpk/nepali-address": "^1.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Dev1191\\FilamentNepaliAddress\\": "src/",
            "Dev1191\\FilamentNepaliAddress\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dev1191\\FilamentNepaliAddress\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dev1191\\FilamentNepaliAddress\\FilamentNepaliAddressServiceProvider"
            ],
            "aliases": {
                "FilamentNepaliAddress": "Dev1191\\FilamentNepaliAddress\\Facades\\FilamentNepaliAddress"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
